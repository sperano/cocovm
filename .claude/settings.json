{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-gate.sh",
            "timeout": 300,
            "statusMessage": "Gate review of the PR diff"
          }
        ]
      }
    ]
  }
}
